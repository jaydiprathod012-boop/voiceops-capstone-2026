# Environment variables for ZentroMart Support Agent
# Copy this file to .env and fill in your values

# ── LLM API Keys (use one or more) ──────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ── Gnani STT/TTS (Step 4 — Voice) ──────────────────────────────────────────
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.gnani.ai/stt/v1/stream
GNANI_TTS_URL=https://api.gnani.ai/tts/v1/synthesize
